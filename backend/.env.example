# Node Environment
NODE_ENV=development
PORT=5000

# CORS Configuration (comma-separated origins allowed in production)
CLIENT_URL=http://localhost:5173,https://your-github-username.github.io

# PostgreSQL Database Connection String
# Example local PostgreSQL: postgresql://postgres:postgres@localhost:5432/lifeos?schema=public
# Example Render/Supabase PostgreSQL: postgresql://user:pass@ep-xyz.postgres.database.azure.com/lifeos?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifeos?schema=public

# Security
JWT_SECRET=super_secret_jwt_key_lifeos_production_change_this_12345
JWT_EXPIRES_IN=7d

# AI Integration Configuration
# AI Provider options: gemini | openai
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.6-flash

# Gmail SMTP Settings for real email notifications
# 1) Enable 2-Step Verification on your Gmail account
# 2) Generate an App Password: https://myaccount.google.com/apppasswords
# 3) Use the 16-character app password without spaces
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_without_spaces
SMTP_FROM="LifeOS Deadline Alerts" <your_email@gmail.com>
