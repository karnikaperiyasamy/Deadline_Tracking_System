# LifeOS Frontend Environment Configuration

# Production API Endpoint (Do not hardcode localhost for production deployment)
# For local dev: http://localhost:5000/api
# For production (Render/Railway): https://your-lifeos-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Base URL path for GitHub Pages deployment
# Default: ./
VITE_BASE_URL=./
